pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t cicd-app:${BUILD_NUMBER} ./app'
            }
        }

        stage('Deploy to Staging') {
            steps {
                sh '''
                    docker rm -f cicd-staging || true

                    docker run -d \
                        --name cicd-staging \
                        -p 5001:5000 \
                        cicd-app:${BUILD_NUMBER}
                '''
            }
        }

        stage('Staging Health Check') {
            steps {
                sh '''
                    sleep 5

                    docker exec cicd-staging python -c "import urllib.request; print(urllib.request.urlopen('http://localhost:5000/health').read().decode())"
                '''
            }
        }

        stage('Deploy to Production') {
            steps {
                sh '''
                    docker rm -f cicd-production || true

                    docker run -d \
                        --name cicd-production \
                        -p 5002:5000 \
                        cicd-app:${BUILD_NUMBER}
                '''
            }
        }

        stage('Production Health Check') {
            steps {
                sh '''
                    sleep 5

                    docker exec cicd-production python -c "import urllib.request; print(urllib.request.urlopen('http://localhost:5000/health').read().decode())"
                '''
            }
        }
    }

    post {
        failure {
            sh '''
                echo "Deployment failed - starting rollback..."

                docker rm -f cicd-production || true

                echo "Rollback completed."
            '''
        }

        always {
            sh '''
                docker rm -f cicd-staging || true
            '''
        }
    }
}