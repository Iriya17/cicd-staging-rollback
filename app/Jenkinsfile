pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t cicd-app:${BUILD_NUMBER} ./app'
            }
        }

        stage('Deploy to Staging') {
            steps {
                sh '''
                    docker rm -f cicd-staging || true

                    docker run -d \
                        --name cicd-staging \
                        -p 5001:5000 \
                        cicd-app:${BUILD_NUMBER}
                '''
            }
        }

        stage('Staging Health Check') {
            steps {
                sh '''
                    sleep 5

                    docker exec cicd-staging python -c "import urllib.request; print(urllib.request.urlopen('http://localhost:5000/health').read().decode())"
                '''
            }
        }

        stage('Save Current Production') {
            steps {
                sh '''
                    if docker inspect cicd-production >/dev/null 2>&1; then
                        docker inspect cicd-production \
                        --format='{{.Config.Image}}' > previous-production-image.txt
                    else
                        echo "No previous production deployment found."
                        echo "NONE" > previous-production-image.txt
                    fi
                '''
            }
        }

        stage('Deploy to Production') {
            steps {
                sh '''
                    docker rm -f cicd-production || true

                    docker run -d \
                        --name cicd-production \
                        -p 5002:5000 \
                        cicd-app:${BUILD_NUMBER}
                '''
            }
        }

        stage('Production Health Check') {
            steps {
                sh '''
                    sleep 5

                    docker exec cicd-production python -c "import urllib.request; print(urllib.request.urlopen('http://localhost:5000/health').read().decode())"
                '''
            }
        }
    }

    post {
        failure {
            sh '''
                echo "Production deployment failed."
                echo "Starting automatic rollback..."

                docker rm -f cicd-production || true

                if [ -f previous-production-image.txt ]; then
                    PREVIOUS_IMAGE=$(cat previous-production-image.txt)

                    if [ "$PREVIOUS_IMAGE" != "NONE" ]; then
                        echo "Restoring previous image: $PREVIOUS_IMAGE"

                        docker run -d \
                            --name cicd-production \
                            -p 5002:5000 \
                            "$PREVIOUS_IMAGE"

                        sleep 5

                        docker exec cicd-production python -c "import urllib.request; print(urllib.request.urlopen('http://localhost:5000/health').read().decode())"

                        echo "Rollback successful."
                    else
                        echo "No previous production version available."
                    fi
                fi
            '''
        }

        always {
            sh '''
                docker rm -f cicd-staging || true
            '''
        }
    }
}